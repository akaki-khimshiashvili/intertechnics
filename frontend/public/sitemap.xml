<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static baseline sitemap covering the app's fixed routes. Individual
  /machines/:slug pages are dynamic (stored in the database, added/removed
  through the admin panel) and can't be listed here without a build step or
  server-side generation — this app is a client-rendered React SPA (CRA,
  no SSR) hosted separately from the PHP API, so there's no single server
  that knows both the current route list and can render this file on
  request. Search engines that execute JavaScript (Googlebot does) will
  still discover and index /machines/:slug pages by following links from
  /machines regardless of their absence here.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.intertechnics.ge/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.intertechnics.ge/machines</loc>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
</urlset>
