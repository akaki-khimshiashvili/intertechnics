{
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "LangContext": ["./src/LangContext"],
      "assets/*": ["./src/assets/*"],
      "components/*": ["./src/components/*"],
      "data/*": ["./src/data/*"],
      "hooks/*": ["./src/hooks/*"],
      "lib/*": ["./src/lib/*"],
      "locales/*": ["./src/locales/*"],
      "pages/*": ["./src/pages/*"],
      "styles/*": ["./src/styles/*"]
    }
  },
  "include": ["src", "vite.config.js"]
}
