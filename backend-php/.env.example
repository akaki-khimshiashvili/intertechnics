APP_ENV=development

DB_HOST=db
DB_PORT=3306
DB_NAME=intertechnics
DB_USER=intertechnics_app
DB_PASS=change-me

# Comma-separated allow-list of origins allowed to call this API with
# credentials (the storefront and the admin panel). Empty disables CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Required. Generate a long random value, e.g.: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=

# Comma-separated IPs of reverse proxies/CDN edges in front of this API whose
# X-Forwarded-For header may be trusted. Leave empty when clients connect
# directly (otherwise any client could spoof its IP and bypass the login limit).
TRUSTED_PROXIES=

# Optional secret for the anonymous daily visitor hash (analytics). Falls back
# to JWT_SECRET. Changing it only affects how today's visitors are counted.
ANALYTICS_SALT=

# Contact form mail (POST /contact). Port 465 = implicit TLS, 587 = STARTTLS.
# Yahoo (used in production): SMTP_HOST=smtp.mail.yahoo.com, SMTP_PORT=465,
# SMTP_USER=the Yahoo address, SMTP_PASS=an app password from Yahoo Account
# Security > "Generate app password" -- not the normal login password.
# Gmail works the same way with smtp.gmail.com and a Google App Password.
# The sender must be the logged-in account (leave SMTP_FROM empty).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender address; defaults to SMTP_USER.
SMTP_FROM=
# Where contact requests are delivered; defaults to intertechnicsltd@gmail.com.
CONTACT_RECIPIENT=
