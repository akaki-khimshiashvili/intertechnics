APP_ENV=development

DB_HOST=db
DB_PORT=3306
DB_NAME=intertechnics
DB_USER=intertechnics_app
DB_PASS=change-me

# Comma-separated allow-list of origins allowed to call this API with
# credentials (the storefront and the admin panel). Empty disables CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Required. Generate a long random value, e.g.: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
